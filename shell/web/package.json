{
  "name": "@shun/installer-web",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "description": "Frontend of the shun installer shell — Vue + hikari (left step rail, per-product branding from the manifest)",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "dump-strings": "npx esbuild src/i18n-dump.ts --bundle --format=cjs --platform=node --outfile=.strings-dump.cjs && node .strings-dump.cjs && del .strings-dump.cjs"
  },
  "dependencies": {
    "@celestia-island/hikari": "^0.55.75",
    "lucide-vue-next": "^*",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "sass": "^1.103.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
