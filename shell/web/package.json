{
  "name": "@shun/installer-web",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "description": "Frontend of the shun installer shell — Vue + hikari (left step rail, per-product branding from the manifest)",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "dump-strings": "npx esbuild src/i18n-dump.ts --bundle --format=cjs --platform=node --outfile=.strings-dump.cjs && node .strings-dump.cjs && node -e \"require('node:fs').rmSync('.strings-dump.cjs',{force:true})\""
  },
  "dependencies": {
    "@celestia-island/hikari": "^0.55",
    "lucide-vue-next": "^1",
    "vue": "^3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6",
    "@vitejs/plugin-vue-jsx": "^5",
    "sass": "^1",
    "typescript": "^7",
    "vite": "^8"
  }
}
