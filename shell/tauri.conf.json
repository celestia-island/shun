{
  "productName": "shun installer",
  "version": "0.1.0",
  "identifier": "world.celestia.shun.installer",
  "build": {
    "beforeBuildCommand": "pnpm --dir web build",
    "frontendDist": "./web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}
